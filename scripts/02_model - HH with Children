###############################################################################
# RRH RECIDIVISM MODELING SCRIPT - REVISED
#
# PURPOSE:
# Build a more useful early-warning model for RRH recidivism using the
# combined-years dataset.
#
# MAIN CHANGES:
# 1. Remove rows with missing target
# 2. Use stronger predictors already available in the dataset
# 3. Simplify sparse / unstable variables
# 4. Focus on logistic baseline + GLMNET
# 5. Tune GLMNET by PR AUC
# 6. Choose operating threshold using CV recall first, then precision, then kappa
#
# IMPORTANT:
# This is a screening model, not a deterministic decision tool.
###############################################################################

###############################################################################
# 1. LOAD LIBRARIES
###############################################################################

library(tidyverse)
library(tidymodels)
library(skimr)
library(glmnet)

tidymodels_prefer()

###############################################################################
# 2. SET GLOBAL OPTIONS / SEED
###############################################################################

set.seed(123)

###############################################################################
# 3. LOAD DATA
###############################################################################

rrh_dataset <- read_csv("combined 2019-2023.csv", show_col_types = FALSE)

###############################################################################
# 4. QUICK INSPECTION
###############################################################################

glimpse(rrh_dataset)

rrh_dataset %>%
  summarise(
    rows = n(),
    unique_clients = n_distinct(clients_unique_identifier)
  ) %>%
  print()

rrh_dataset %>%
  count(target_recidivated, .drop = FALSE) %>%
  print()

###############################################################################
# 5. REMOVE MISSING TARGET ROWS
#
# WHY:
# We cannot train a supervised model without a known outcome.
###############################################################################

rrh_dataset <- rrh_dataset %>%
  filter(!is.na(target_recidivated))

cat("\nAfter removing rows with missing target:\n")
rrh_dataset %>%
  count(target_recidivated) %>%
  print()

###############################################################################
# 6. RESTRICT TO SERVICE-ELIGIBLE CLIENTS
###############################################################################

excluded_435_subsidy_types <- c(
  "RRH or equivalent subsidy",
  "Permanent Supportive Housing"
)

rrh_dataset_eligible <- rrh_dataset %>%
  mutate(
    destination_code = suppressWarnings(as.numeric(destination_code)),
    rental_subsidy_type = as.character(rental_subsidy_type),
    
    service_eligible = case_when(
      destination_code %in% c(410, 411, 421) ~ 1L,
      destination_code == 435 &
        !rental_subsidy_type %in% excluded_435_subsidy_types ~ 1L,
      TRUE ~ 0L
    )
  ) %>%
  filter(service_eligible == 1L) %>%
  filter(num_children >= 1)

cat("\nBefore / after eligibility restriction:\n")

rrh_dataset %>%
  summarise(
    rows_before = n(),
    clients_before = n_distinct(clients_unique_identifier)
  ) %>%
  print()

rrh_dataset_eligible %>%
  summarise(
    rows_after = n(),
    clients_after = n_distinct(clients_unique_identifier)
  ) %>%
  print()

rrh_dataset_eligible %>%
  count(destination_code, rental_subsidy_type, sort = TRUE) %>%
  print(n = 50)

###############################################################################
# CREATE MODELING DATA
###############################################################################

rrh_model_data <- rrh_dataset_eligible %>%
  mutate(
    target_recidivated = factor(
      if_else(target_recidivated == 1, "Yes", "No"),
      levels = c("No", "Yes")
    ),
    
    current_income_flag = factor(
      if_else(coalesce(income_at_exit_earned, 0) > 0, "Yes", "No"),
      levels = c("No", "Yes")
    ),
    
    eviction_bucket = factor(
      case_when(
        coalesce(num_evictions_prior_to_baseline, 0) == 0 ~ "0",
        coalesce(num_evictions_prior_to_baseline, 0) == 1 ~ "1",
        coalesce(num_evictions_prior_to_baseline, 0) >= 2 ~ "2_plus"
      ),
      levels = c("0", "1", "2_plus")
    ),
    
    high_instability_flag = factor(
      if_else(
        coalesce(prior_recidivism_count, 0) >= 2 |
          coalesce(number_prior_psh_rrh_enrollments, 0) >= 2 |
          coalesce(count_of_homeless_months, 0) >= 6 |
          coalesce(number_of_years_engaged_with_coc, 0) >= 5,
        "Yes",
        "No"
      ),
      levels = c("No", "Yes")
    )
  ) %>%
  select(
    target_recidivated,
    high_instability_flag,
    current_income_flag,
    eviction_bucket
  )

###############################################################################
# TRAIN / TEST SPLIT
###############################################################################

set.seed(123)

rrh_split <- initial_split(
  rrh_model_data,
  prop = 0.80,
  strata = target_recidivated
)

rrh_train <- training(rrh_split)
rrh_test  <- testing(rrh_split)

###############################################################################
# FIT LOGISTIC MODEL
###############################################################################

simple_model <- glm(
  target_recidivated ~
    high_instability_flag +
    current_income_flag +
    eviction_bucket,
  data = rrh_train,
  family = binomial()
)

summary(simple_model)

###############################################################################
# ODDS RATIOS
###############################################################################

odds_ratios <- broom::tidy(simple_model) %>%
  mutate(
    odds_ratio = exp(estimate),
    lower_ci = exp(estimate - 1.96 * std.error),
    upper_ci = exp(estimate + 1.96 * std.error)
  )

print(odds_ratios)

###############################################################################
# PREDICT TEST SET
###############################################################################

rrh_test_pred <- rrh_test %>%
  mutate(
    pred_prob = predict(simple_model, newdata = rrh_test, type = "response")
  )

summary(rrh_test_pred$pred_prob)

###############################################################################
# ROC AUC
###############################################################################

roc_tbl <- roc_auc(
  rrh_test_pred,
  truth = target_recidivated,
  pred_prob,
  event_level = "second"
)

print(roc_tbl)

###############################################################################
# TEST MULTIPLE THRESHOLDS
###############################################################################

thresholds <- seq(0.05, 0.30, by = 0.025)

threshold_results <- purrr::map_dfr(thresholds, function(thresh) {
  
  preds <- rrh_test_pred %>%
    mutate(
      pred_class = factor(
        if_else(pred_prob >= thresh, "Yes", "No"),
        levels = c("No", "Yes")
      )
    )
  
  tibble(
    threshold = thresh,
    
    accuracy = accuracy(
      preds,
      truth = target_recidivated,
      estimate = pred_class
    )$.estimate,
    
    recall_yes = sens(
      preds,
      truth = target_recidivated,
      estimate = pred_class,
      event_level = "second"
    )$.estimate,
    
    specificity_no = yardstick::spec(
      preds,
      truth = target_recidivated,
      estimate = pred_class,
      event_level = "second"
    )$.estimate,
    
    precision_yes = precision(
      preds,
      truth = target_recidivated,
      estimate = pred_class,
      event_level = "second"
    )$.estimate,
    
    kap = kap(
      preds,
      truth = target_recidivated,
      estimate = pred_class
    )$.estimate
  )
})

print(threshold_results)

###############################################################################
# USE FIXED THRESHOLD = 0.10
###############################################################################

chosen_threshold <- 0.10

rrh_test_final <- rrh_test_pred %>%
  mutate(
    pred_class = factor(
      if_else(pred_prob >= chosen_threshold, "Yes", "No"),
      levels = c("No", "Yes")
    )
  )

###############################################################################
# CONFUSION MATRIX
###############################################################################

cm <- conf_mat(
  rrh_test_final,
  truth = target_recidivated,
  estimate = pred_class
)

print(cm)

###############################################################################
# FINAL METRICS
###############################################################################

final_metrics <- tibble(
  threshold = chosen_threshold,
  
  accuracy = accuracy(
    rrh_test_final,
    truth = target_recidivated,
    estimate = pred_class
  )$.estimate,
  
  recall_yes = sens(
    rrh_test_final,
    truth = target_recidivated,
    estimate = pred_class,
    event_level = "second"
  )$.estimate,
  
  specificity_no = yardstick::spec(
    rrh_test_final,
    truth = target_recidivated,
    estimate = pred_class,
    event_level = "second"
  )$.estimate,
  
  precision_yes = precision(
    rrh_test_final,
    truth = target_recidivated,
    estimate = pred_class,
    event_level = "second"
  )$.estimate,
  
  kap = kap(
    rrh_test_final,
    truth = target_recidivated,
    estimate = pred_class
  )$.estimate,
  
  roc_auc_yes = roc_tbl$.estimate
)

print(final_metrics)

###############################################################################
# OPTIONAL: LOOK AT HIGHEST-RISK PEOPLE
###############################################################################

rrh_test_pred %>%
  arrange(desc(pred_prob)) %>%
  select(pred_prob, everything()) %>%
  head(20)


###############################################################################
# TOP-N REVIEW TABLE
#
# PURPOSE:
# Show how many true recidivism cases are captured if staff review only the
# highest-risk 10%, 15%, 20%, or 25%.
###############################################################################

rrh_test_ranked <- rrh_test_pred %>%
  arrange(desc(pred_prob)) %>%
  mutate(
    risk_rank = row_number()
  )

top_n_results <- tibble(
  top_pct = c(0.10, 0.15, 0.20, 0.25)
) %>%
  rowwise() %>%
  mutate(
    n_flagged = ceiling(nrow(rrh_test_ranked) * top_pct),
    
    true_positives = sum(
      rrh_test_ranked$target_recidivated[1:n_flagged] == "Yes"
    ),
    
    false_positives = sum(
      rrh_test_ranked$target_recidivated[1:n_flagged] == "No"
    ),
    
    total_actual_positives = sum(rrh_test_ranked$target_recidivated == "Yes"),
    
    recall_yes = true_positives / total_actual_positives,
    
    precision_yes = true_positives / n_flagged
  ) %>%
  ungroup()

print(top_n_results)

###############################################################################
# CREATE TOP 25% WATCHLIST
###############################################################################

top_25_watchlist <- rrh_test_ranked %>%
  slice_head(n = ceiling(nrow(rrh_test_ranked) * 0.25))

print(top_25_watchlist)

###############################################################################
# OPTIONAL: SAVE WATCHLIST
###############################################################################

write_csv(top_25_watchlist, "rrh_top_25_watchlist.csv")


###############################################################################
# TOP-N CAPTURE CURVE
#
# PURPOSE:
# Show how many of the actual recidivism cases are captured when staff review
# only the highest-risk households.
#
# INTERPRETATION:
# If the curve shows that reviewing the top 25% captures 53% of recidivism
# cases, that means staff can review a manageable subset and still catch over
# half of the future recidivism cases.
###############################################################################

library(tidyverse)
library(scales)

# Start with the test set predictions
# These should already include:
# - pred_prob = predicted probability of recidivism
# - target_recidivated = actual outcome ("No", "Yes")
rrh_test_ranked <- rrh_test_pred %>%
  
  # Sort from highest predicted risk to lowest
  arrange(desc(pred_prob)) %>%
  
  # Give each row a rank after sorting
  mutate(risk_rank = row_number())

# Define the review percentages you want to evaluate
# Example:
# 0.10 = top 10% highest-risk households
# 0.25 = top 25% highest-risk households
review_levels <- c(0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50)

# Build a summary table showing how many true cases are captured
top_n_curve <- tibble(top_pct = review_levels) %>%
  rowwise() %>%
  mutate(
    
    # Number of households that would be reviewed at this cutoff
    n_flagged = ceiling(nrow(rrh_test_ranked) * top_pct),
    
    # Among the flagged households, how many truly recidivated?
    true_positives = sum(
      rrh_test_ranked$target_recidivated[1:n_flagged] == "Yes"
    ),
    
    # Total actual recidivism cases in the test set
    total_actual_positives = sum(rrh_test_ranked$target_recidivated == "Yes"),
    
    # Recall = percent of true recidivism cases captured
    recall_yes = true_positives / total_actual_positives,
    
    # Precision = percent of flagged households that actually recidivated
    precision_yes = true_positives / n_flagged
  ) %>%
  ungroup()

# Print the table so you can inspect the values directly
print(top_n_curve)

###############################################################################
# PLOT THE TOP-N CAPTURE CURVE
###############################################################################

ggplot(top_n_curve, aes(x = top_pct, y = recall_yes)) +
  
  # Draw the line connecting the review levels
  geom_line(linewidth = 1) +
  
  # Add points so each review level is easy to see
  geom_point(size = 3) +
  
  # Show percentages nicely on both axes
  scale_x_continuous(labels = percent_format(accuracy = 1)) +
  scale_y_continuous(labels = percent_format(accuracy = 1)) +
  
  # Titles and axis labels
  labs(
    title = "Top-N Capture Curve",
    subtitle = "How many actual recidivism cases are captured by reviewing the highest-risk households",
    x = "Percent of Highest-Risk Households Reviewed",
    y = "Percent of Actual Recidivism Cases Captured (Recall)"
  ) +
  
  # Cleaner appearance
  theme_minimal()
