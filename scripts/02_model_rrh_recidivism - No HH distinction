###############################################################################

saveRDS(log_res, "log_res.rds")
saveRDS(glmnet_res, "glmnet_res.rds")
saveRDS(rf_res, "rf_res.rds")
saveRDS(xgb_res, "xgb_res.rds")
saveRDS(final_fit, "final_fit.rds")

write_csv(final_metrics, "final_model_test_metrics_default_threshold.csv")
write_csv(final_predictions, "final_model_test_predictions.csv")
write_csv(threshold_results_cv, "cv_threshold_comparison.csv")
write_csv(test_threshold_metrics, "final_model_test_metrics_best_threshold.csv")
write_csv(final_predictions_best_thresh, "final_model_test_predictions_best_threshold.csv")

